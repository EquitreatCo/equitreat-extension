# === Supabase Configuration ===
# Get your Supabase project URL from https://app.supabase.com/projects
# Format: https://<YOUR_PROJECT_REF>.supabase.co
VITE_SUPABASE_URL=https://<YOUR_PROJECT_REF>.supabase.co

# Get your publishable key from Supabase project settings
VITE_SUPABASE_PUBLISHABLE_KEY=<YOUR_PUBLISHABLE_KEY>

# === OAuth Configuration ===
# Google OAuth client ID (from Google Cloud Console)
VITE_GOOGLE_CLIENT_ID=<YOUR_GOOGLE_CLIENT_ID>

# Extension public key (for signing)
VITE_EXTENSION_PUBLIC_KEY=<YOUR_EXTENSION_PUBLIC_KEY>

# === Wallet Connect ===
# URL where users can connect their wallets
VITE_WALLET_CONNECT_URL=https://www.equitreat.org/claim-rewards
